# Copy to .env (or .env.qa / .env.uat and run with TEST_ENV=qa) and fill in.
# A product whose URL is empty is skipped. Every product reads its own <KEY>_* variables
# (PI_*, PPP_*, CMBC_*, FLEET_*, MTP_*); products on the same host share one sign-in.
# Run one or several: npm run smoke -- --products pi,cmbc --mode sequential|parallel   (npm run smoke:select asks)

# Expected build/version string; when set, each product's build label is checked against it.
EXPECTED_BUILD=

# Shared credentials used when a product-specific one is not set
SMOKE_USER=
SMOKE_PASSWORD=

PI_URL=https://axapreqc.advantagego.com
PI_USER=
PI_PASSWORD=

PPP_URL=https://axapreqc.advantagego.com
PPP_USER=
PPP_PASSWORD=
# Reference quote the working quotes are Model copies of, and the schedule imported on the PPP risk section
PPP_TEMPLATE_QUOTE_URL=https://axapreqc.advantagego.com/ui/Quote/Edit/117292
PPP_SCHEDULE_IMPORT=PPP\PPP_Schedule_Import.xlsx
# Resume URLs, same idea as CMBC_*: PPP_QUOTE_URL, PPP_POLICY_URL, PPP_ENDORSEMENT_URL, PPP_ENDORSED_POLICY_URL,
# PPP_CANCEL_POLICY_URL, PPP_CANCEL_MTA_URL, PPP_REINSTATE_MTA_URL

CMBC_URL=
CMBC_USER=
CMBC_PASSWORD=
CMBC_TEMPLATE_QUOTE_URL=https://axapreqc.advantagego.com/ui/Quote/Edit/117365
CMBC_SCHEDULE_IMPORT=CMBC\CMBC_Schedule_Import.xlsx
CMBC_QUOTE_URL=
CMBC_POLICY_URL=
CMBC_ENDORSEMENT_URL=
CMBC_CANCEL_POLICY_URL=
CMBC_CANCEL_MTA_URL=
CMBC_REINSTATE_MTA_URL=
# Use the signed-in persistent Edge profile when copied SSO storage is not sufficient.
# (Works for any product as <KEY>_USE_EDGE_PROFILE=1; such a product is limited to one worker.)
CMBC_USE_EDGE_PROFILE=

FLEET_URL=
FLEET_USER=
FLEET_PASSWORD=

MTP_URL=https://axapreqc.advantagego.com
MTP_USER=
MTP_PASSWORD=
# Reference quote RSK0003740201Q001 (Motor Trade, Taken Up): copied with ⋮ → Model for each run
MTP_TEMPLATE_QUOTE_URL=https://axapreqc.advantagego.com/ui/Quote/Edit/117276
MTP_SCHEDULE_IMPORT=MTP\MTP_Schedule_Import.xlsx
# Resume URLs, same idea as CMBC_*: MTP_QUOTE_URL, MTP_POLICY_URL, MTP_ENDORSEMENT_URL, MTP_ENDORSED_POLICY_URL,
# MTP_CANCEL_POLICY_URL, MTP_CANCEL_MTA_URL, MTP_REINSTATE_MTA_URL

# Use an installed browser (msedge | chrome) if Playwright's Chromium download is blocked
BROWSER_CHANNEL=

# Issue Quote waits this long for the Licence Referral task to be approved (0 = skip if not approved)
APPROVAL_WAIT_MINUTES=30

# Optional: an issued quote copied with ⋮ → Model for each run instead of New Submission + Convert to Quote
PI_TEMPLATE_QUOTE_URL=
